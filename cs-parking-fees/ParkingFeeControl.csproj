<Project Sdk="Microsoft.NET.Sdk">

	<!-- PROJECT METADATA -->

	<PropertyGroup>
		<Title>Parking Fee Control</Title>
		<Product>Parking Fee Control</Product>
		<Authors>kpgocek, thiago-rcarvalho</Authors>
		<Description>Parking fee management for Cities: Skylines II.</Description>

		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/kpgocek/parking-fee-control</RepositoryUrl>
	</PropertyGroup>

	<!-- PROJECT CONFIGURATION -->

	<PropertyGroup>
		<TargetFramework>net48</TargetFramework>
		<AssemblyName>ParkingFeeControl</AssemblyName>
		<RootNamespace>ParkingFeeControl</RootNamespace>

		<!-- Compiler -->
		<Nullable>enable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

		<!-- Versioning -->
		<Version>0.5.1</Version>
		<AssemblyVersion>0.5.1.0</AssemblyVersion>
		<FileVersion>$(Version)</FileVersion>

		<!-- Timestamp-based build identifier -->
		<BuildNumber>$([System.DateTime]::Now.ToString('yyyyMMddHHmm'))</BuildNumber>
		<InformationalVersion>$(Version)+$(BuildNumber)</InformationalVersion>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

		<!-- Release debugging symbols -->
		<DebugType Condition="'$(Configuration)' == 'Release'">portable</DebugType>

		<!-- Paradox Mods configuration -->
		<PublishConfigurationPath>$(MSBuildProjectDirectory)\Properties\PublishConfiguration.xml</PublishConfigurationPath>
		<PdxDirectory>$(MSBuildProjectDirectory)\..\pdx</PdxDirectory>
	</PropertyGroup>

	<!-- CITIES: SKYLINES II SDK -->

	<PropertyGroup>
		<CSII_TOOLPATH Condition="'$(CSII_TOOLPATH)' == ''">$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))</CSII_TOOLPATH>
		<ManagedPath Condition="'$(ManagedPath)' == '' and '$(CSII_MANAGEDPATH)' != ''">$(CSII_MANAGEDPATH)</ManagedPath>
	</PropertyGroup>

	<Import
        Project="$(CSII_TOOLPATH)\Mod.props"
        Condition="'$(OS)' == 'Windows_NT' and Exists('$(CSII_TOOLPATH)\Mod.props')" />

	<Import
        Project="$(CSII_TOOLPATH)\Mod.targets"
        Condition="'$(OS)' == 'Windows_NT' and Exists('$(CSII_TOOLPATH)\Mod.targets')" />

	<!-- The SDK reads user environment variables. Also support process environments
         (terminal, IDE and CI) without requiring changes to machine settings. -->
	<PropertyGroup>
		<LangVersion>latest</LangVersion>
		<ManagedPath Condition="'$(MANAGED_DLLS_PATH)' != ''">$(MANAGED_DLLS_PATH)</ManagedPath>
		<ManagedPath Condition="'$(ManagedPath)' == ''">$(CSII_MANAGEDPATH)</ManagedPath>
		<MANAGED_DLLS_PATH Condition="'$(MANAGED_DLLS_PATH)' == ''">$(ManagedPath)</MANAGED_DLLS_PATH>
		<UserDataPath Condition="'$(CSII_USERDATAPATH)' != ''">$(CSII_USERDATAPATH)</UserDataPath>
		<LocalModsPath Condition="'$(CSII_LOCALMODSPATH)' != ''">$(CSII_LOCALMODSPATH)</LocalModsPath>
		<UnityModProjectPath Condition="'$(CSII_UNITYMODPROJECTPATH)' != ''">$(CSII_UNITYMODPROJECTPATH)</UnityModProjectPath>
		<ModPostProcessorPath Condition="'$(CSII_MODPOSTPROCESSORPATH)' != ''">$(CSII_MODPOSTPROCESSORPATH)</ModPostProcessorPath>
		<ModPublisherPath Condition="'$(CSII_MODPUBLISHERPATH)' != ''">$(CSII_MODPUBLISHERPATH)</ModPublisherPath>
		<MSCORLIBPath Condition="'$(CSII_MSCORLIBPATH)' != ''">$(CSII_MSCORLIBPATH)</MSCORLIBPath>
		<EntitiesVersion Condition="'$(CSII_ENTITIESVERSION)' != ''">$(CSII_ENTITIESVERSION)</EntitiesVersion>
		<EntityPackagePath>$(UnityModProjectPath)\Library\PackageCache\com.unity.entities@$(EntitiesVersion)\Unity.Entities\SourceGenerators</EntityPackagePath>
	</PropertyGroup>

	<ItemGroup Condition="'$(ModPropsFile)' != ''">
		<_SDKAnalyzers Include="@(Analyzer)" />
		<Analyzer Remove="@(_SDKAnalyzers)" />
		<Analyzer Include="@(_SDKAnalyzers->'$(EntityPackagePath)\%(Filename)%(Extension)')" />
		<Reference Include="$(MSCORLIBPath)" Condition="'$(MSCORLIBPath)' != ''">
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<Target Name="ValidateCSIIEnvironment"
            BeforeTargets="PrepareForBuild"
            Condition="'$(OS)' == 'Windows_NT'">

		<Error
            Condition="'$(CSII_TOOLPATH)' == ''"
            Text="CSII_TOOLPATH environment variable is not set." />

		<Error
            Condition="!Exists('$(CSII_TOOLPATH)\Mod.props')"
            Text="CSII Mod.props not found. Check CSII_TOOLPATH." />

		<Error
            Condition="!Exists('$(CSII_TOOLPATH)\Mod.targets')"
            Text="CSII Mod.targets not found. Check CSII_TOOLPATH." />
	</Target>

	<!-- GAME AND UNITY REFERENCES -->

	<ItemGroup>
		<!-- Unity Engine -->
		<Reference Include="UnityEngine.CoreModule">
			<HintPath>$(MANAGED_DLLS_PATH)\UnityEngine.CoreModule.dll</HintPath>
			<Private>False</Private>
		</Reference>

		<Reference Include="Unity.Entities">
			<HintPath>$(MANAGED_DLLS_PATH)\Unity.Entities.dll</HintPath>
			<Private>False</Private>
		</Reference>

		<Reference Include="Unity.Collections">
			<HintPath>$(MANAGED_DLLS_PATH)\Unity.Collections.dll</HintPath>
			<Private>False</Private>
		</Reference>

		<Reference Include="Unity.Mathematics">
			<HintPath>$(MANAGED_DLLS_PATH)\Unity.Mathematics.dll</HintPath>
			<Private>False</Private>
		</Reference>

		<Reference Include="Unity.Burst">
			<HintPath>$(MANAGED_DLLS_PATH)\Unity.Burst.dll</HintPath>
			<Private>False</Private>
		</Reference>

		<Reference Include="Newtonsoft.Json">
			<HintPath>$(MANAGED_DLLS_PATH)\Newtonsoft.Json.dll</HintPath>
			<Private>False</Private>
		</Reference>

		<!-- Cities: Skylines II -->
		<Reference Include="Game">
			<HintPath>$(MANAGED_DLLS_PATH)\Game.dll</HintPath>
			<Private>False</Private>
		</Reference>

		<Reference Include="Colossal.Core">
			<HintPath>$(MANAGED_DLLS_PATH)\Colossal.Core.dll</HintPath>
			<Private>False</Private>
		</Reference>

		<Reference Include="Colossal.Logging">
			<HintPath>$(MANAGED_DLLS_PATH)\Colossal.Logging.dll</HintPath>
			<Private>False</Private>
		</Reference>

		<Reference Include="Colossal.Localization">
			<HintPath>$(MANAGED_DLLS_PATH)\Colossal.Localization.dll</HintPath>
			<Private>False</Private>
		</Reference>

		<Reference Include="Colossal.IO.AssetDatabase">
			<HintPath>$(MANAGED_DLLS_PATH)\Colossal.IO.AssetDatabase.dll</HintPath>
			<Private>False</Private>
		</Reference>

		<Reference Include="Colossal.UI">
			<HintPath>$(MANAGED_DLLS_PATH)\Colossal.UI.dll</HintPath>
			<Private>False</Private>
		</Reference>

		<Reference Include="Colossal.UI.Binding">
			<HintPath>$(MANAGED_DLLS_PATH)\Colossal.UI.Binding.dll</HintPath>
			<Private>False</Private>
		</Reference>

		<Reference Include="Colossal.AssetPipeline">
			<HintPath>$(MANAGED_DLLS_PATH)\Colossal.AssetPipeline.dll</HintPath>
			<Private>False</Private>
		</Reference>

		<Reference Include="Colossal.Mathematics">
			<HintPath>$(MANAGED_DLLS_PATH)\Colossal.Mathematics.dll</HintPath>
			<Private>False</Private>
		</Reference>
	</ItemGroup>

	<!-- RESOURCES AND CONTENT -->

	<ItemGroup>
		<!-- Embedded game data -->
		<EmbeddedResource Include="parking-data.json" />

		<!-- Localization files -->
		<None Update="Locale\*.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>

	</ItemGroup>

	<!-- FRONTEND CONFIGURATION -->

	<PropertyGroup>
		<UIRoot>$(MSBuildProjectDirectory)\..\parking-fees-ui</UIRoot>
		<UIOutput>$(UIRoot)\output</UIOutput>
		<UIBuildStamp>$(UIOutput)\.build-stamp</UIBuildStamp>
		<UIRestoreStamp>$(UIRoot)\node_modules\.parking-fee-restore-stamp</UIRestoreStamp>
		<UIVersionFile>$(MSBuildProjectDirectory)\obj\$(Configuration)\ui-version.txt</UIVersionFile>
	</PropertyGroup>

	<!-- FRONTEND BUILD PIPELINE -->

	<!-- Restore when dependencies are missing or either package manifest changes. -->
	<Target Name="RestoreUI"
			Inputs="$(UIRoot)\package.json;$(UIRoot)\package-lock.json"
			Outputs="$(UIRestoreStamp)"
			Condition="'$(ModPublisherCommand)' != 'Update' and '$(DesignTimeBuild)' != 'true'">

		<Message Importance="high"
                 Text="Restoring frontend dependencies..." />

		<Exec Command="npm ci"
              WorkingDirectory="$(UIRoot)" />
		<Touch Files="$(UIRestoreStamp)" AlwaysCreate="true" />

		<!-- Force UI rebuild after dependency restoration -->
		<Delete Files="$(UIBuildStamp)" />
	</Target>

	<Target Name="PrepareUIBuild" DependsOnTargets="RestoreUI">
		<!-- Keep build-only UI inputs out of the IDE project tree. -->
		<ItemGroup>
			<!-- Frontend sources -->
			<UIInputs Include="$(UIRoot)\src\**\*.*" />
			<UIInputs Include="$(UIRoot)\types\**\*.*" />
			<UIInputs Include="$(UIRoot)\webpack.config.js" />
			<UIInputs Include="$(MSBuildProjectFullPath)" />

			<!-- Frontend configuration -->
			<UIInputs Include="$(UIRoot)\package.json" />
			<UIInputs Include="$(UIRoot)\package-lock.json" />
			<UIInputs Include="$(UIRoot)\mod.json" />

			<UIInputs Include="$(UIRoot)\tsconfig.json"
                  Condition="Exists('$(UIRoot)\tsconfig.json')" />
		</ItemGroup>
		<MakeDir Directories="$(MSBuildProjectDirectory)\obj\$(Configuration)" />
		<WriteLinesToFile File="$(UIVersionFile)" Lines="$(Version)" Overwrite="true" WriteOnlyWhenDifferent="true" />
	</Target>

	<!-- Build frontend independently of deployment, including on Linux. -->
	<Target Name="BuildUI"
            DependsOnTargets="PrepareUIBuild"
            Inputs="@(UIInputs);$(UIVersionFile)"
            Outputs="$(UIBuildStamp);$(UIOutput)\ParkingFeeControl.mjs;$(UIOutput)\mod.json"
            Condition="'$(ModPublisherCommand)' != 'Update' and '$(DesignTimeBuild)' != 'true'">

		<Message Importance="high"
                 Text="Building Parking Fee Control UI..." />

		<Exec Command="npm run build"
              EnvironmentVariables="PARKING_FEE_VERSION=$(Version)"
              WorkingDirectory="$(UIRoot)" />

		<Error Condition="!Exists('$(UIOutput)\ParkingFeeControl.mjs') or !Exists('$(UIOutput)\mod.json')"
               Text="UI build did not produce ParkingFeeControl.mjs and mod.json." />
		<!-- Webpack preserves timestamps for unchanged assets; mark verified outputs current. -->
		<Touch Files="$(UIOutput)\ParkingFeeControl.mjs;$(UIOutput)\mod.json" />
		<Touch Files="$(UIBuildStamp)" AlwaysCreate="true" />
	</Target>

	<!-- Assemble UI in the C# output before the SDK copies it to DeployDir. -->
	<PropertyGroup>
		<ModAssemblyDependencies>BuildUI</ModAssemblyDependencies>
		<ModAssemblyDependencies Condition="'$(OS)' == 'Windows_NT'">RunModPostProcessor;BuildUI</ModAssemblyDependencies>
	</PropertyGroup>
	<Target Name="CopyUIFiles"
            BeforeTargets="DeployWIP"
            AfterTargets="Build"
            DependsOnTargets="$(ModAssemblyDependencies)"
            Condition="'$(NeedBuild)' == 'true' or '$(OS)' != 'Windows_NT'">

		<Error Condition="!Exists('$(UIOutput)\ParkingFeeControl.mjs') or !Exists('$(UIOutput)\mod.json')"
               Text="UI build did not produce ParkingFeeControl.mjs and mod.json." />

		<ItemGroup>
			<UIFiles Include="$(UIOutput)\**\*.*"
                     Exclude="$(UIBuildStamp)" />
		</ItemGroup>

		<Message Importance="high"
				 Text="Assembling frontend assets in $(OutDir)" />

		<Copy
            SourceFiles="@(UIFiles)"
            DestinationFiles="@(UIFiles->'$(OutDir)\%(RecursiveDir)%(Filename)%(Extension)')"
            SkipUnchangedFiles="true"
            Condition="'@(UIFiles)' != ''" />
	</Target>

	<!-- Clean generated frontend files -->
	<Target Name="CleanUIOutput"
            BeforeTargets="Clean"
            Condition="Exists('$(UIOutput)')">

		<RemoveDir Directories="$(UIOutput)" />
	</Target>

	<!-- VERSION SYNCHRONIZATION -->

	<!-- The UI build receives Version and emits matching metadata without editing sources. -->
	<Target Name="ValidateModContent" BeforeTargets="RunModPublisher"
            Condition="'$(ModPublisherCommand)' != 'Update'">
		<Error Condition="!Exists('$(ContentFullPath)\ParkingFeeControl.dll') or !Exists('$(ContentFullPath)\ParkingFeeControl.mjs') or !Exists('$(ContentFullPath)\mod.json') or !Exists('$(ContentFullPath)\Locale\en-US.json')"
               Text="Publishing content is incomplete. Build the complete mod before publishing." />
	</Target>

	<!-- PARADOX MODS PUBLISHING METADATA -->

	<!-- Prepare metadata for release builds -->
	<Target Name="SetupAttributes"
            BeforeTargets="BeforeBuild"
            Condition="'$(Configuration)' == 'Release'">

		<XmlPoke
            XmlInputPath="$(PublishConfigurationPath)"
            Query="//LongDescription"
            Value="$([System.IO.File]::ReadAllText('$(PdxDirectory)\ABOUT.md'))"
            Condition="Exists('$(PdxDirectory)\ABOUT.md')" />

		<XmlPoke
            XmlInputPath="$(PublishConfigurationPath)"
            Query="//ChangeLog"
            Value="$([System.IO.File]::ReadAllText('$(PdxDirectory)\CHANGELOG.md'))"
            Condition="Exists('$(PdxDirectory)\CHANGELOG.md')" />

		<XmlPoke
            XmlInputPath="$(PublishConfigurationPath)"
            Query="//ModVersion/@Value"
            Value="$(Version)" />
	</Target>

</Project>
